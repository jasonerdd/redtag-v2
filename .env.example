# Copy this file to a new file named exactly  .env  in the app folder on the server, then fill it in.
# Never upload .env to GitHub and never put it inside public_html.
DJANGO_ENV=production
DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=operations.yourdomain.com

# From cPanel > MySQL Databases (cPanel adds your account prefix to both names)
DB_NAME=cpaneluser_operations
DB_USER=cpaneluser_opsuser
DB_PASSWORD=the-database-user-password
DB_HOST=localhost
DB_PORT=3306

# Only for the FIRST deploy, then delete these three lines:
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
